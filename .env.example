# AI Provider - use one of the following
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram Chat ID (for receiving owner notifications)
OWNER_TELEGRAM_CHAT_ID=your_chat_id_here

# Business Info (shown on PDFs)
BUSINESS_NAME=My Business
BUSINESS_ADDRESS=123 Main Street, City, State - 400001
BUSINESS_PHONE=+91-XXXXXXXXXX
BUSINESS_EMAIL=business@example.com
BUSINESS_GST=22AAAAA0000A1Z5
BUSINESS_LOGO_PATH=

# App Settings
SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///./quotation_app.db
API_BASE_URL=http://localhost:8000

# Payment Gateway (Razorpay - upgrade later)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# GST Settings
DEFAULT_GST_PERCENT=18
